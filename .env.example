RELEASE_SENTINEL_MODEL=gemini-3.6-flash
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
RELEASE_SENTINEL_POLICY_DATABASE=release-sentinel-policy
RELEASE_SENTINEL_LEDGER_DATABASE=(default)
RELEASE_SENTINEL_POLICY_ID=demo-release-policy
RELEASE_SENTINEL_POLICY_REVISION=1
RELEASE_SENTINEL_POLICY_SHA256=
# Final provenance signing key (orchestrator may use this key).
RELEASE_SENTINEL_PROVENANCE_SIGNING_REQUIRED=true
RELEASE_SENTINEL_KMS_KEY_VERSION=
# Evidence signing key (only the dedicated Attestor service account may sign).
RELEASE_SENTINEL_EVIDENCE_KMS_KEY_VERSION=
RELEASE_SENTINEL_ATTESTOR_URL=
RELEASE_SENTINEL_ATTESTOR_AUDIENCE=
RELEASE_SENTINEL_GATEKEEPER_URL=
RELEASE_SENTINEL_GATEKEEPER_AUDIENCE=
